Windows Registry Editor Version 5.00

; ============================================================
; 02_GPU_AMD: твики реестра под AMD Radeon (Win11)
; Применяется ДОПОЛНИТЕЛЬНО к 00_COMMON_BASE.
; НЕ применять вместе с 01_GPU_NVIDIA!
; Откат: _RESTORE\Restore_GPU.reg
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"TdrLevel"=dword:00000000
"TdrDelay"=dword:0000000a
"TdrDdiDelay"=dword:0000000a

; --- AMD: отключить гибридный режим питания GPU (выход из idle = фризы в CS2)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\amdkmdag]
"DisableDMACs"=dword:00000001

; --- Отключить телеметрию Adrenalin
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\RadeonSettingsService]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SOFTWARE\AMD\CN]
"GMODEnable"=dword:00000000
"GDEnabled"=dword:00000000

; --- AntiLag предпочтения задаются в Adrenalin (см. NOTE_AntiLag.txt),
;     реестром не выставляются корректно на актуальных драйверах.

; --- USB polling для мыши повыше — общий твик, но критичен на AMD чипсетах
;     с агрессивным power management USB-портов
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\USB]
"DisableSelectiveSuspend"=dword:00000001

; --- Запрет отключения USB-устройств для экономии энергии (мышь/клава)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum\USB]
; применяется скриптом Disable_USB_Sleep.bat (нужен перебор устройств)
