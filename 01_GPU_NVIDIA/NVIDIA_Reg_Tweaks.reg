Windows Registry Editor Version 5.00

; ============================================================
; 01_GPU_NVIDIA: твики реестра под NVIDIA GeForce (Win11)
; Применяется ДОПОЛНИТЕЛЬНО к 00_COMMON_BASE.
; НЕ применять вместе с 02_GPU_AMD!
; Откат: _RESTORE\Restore_GPU.reg
; ============================================================

; --- TCC / GPU Timeout: больше времени на длинный кадр, меньше "видео-дривер остановлен"
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"TdrLevel"=dword:00000000
"TdrDelay"=dword:0000000a
"TdrDdiDelay"=dword:0000000a

; --- Отключить запись драйвера в системный лог (мелочь, но снижает шум DPC)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\nvlddmkm]
"LogEvents"=dword:00000000

; --- MSI mode для NVIDIA-устройства включается скриптом Enable_MSImode.bat
; (реестром напрямую не задаётся — только через devcon/PowerShell)

; --- Режим питания NVIDIA: не щадить GPU в простое (быстрее выход из idle = меньше first-frame latency)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\nvlddmkm\PM]
"NvPmEnableGddpParam"=dword:00000000

; --- Отключить гибридный фреймбуфер / Base Clock Reporting артефакты
[HKEY_LOCAL_MACHINE\SOFTWARE\NVIDIA Corporation\Global]
"StablePowerSavings"=dword:00000000

; --- HDCP/Telemetry off
[HKEY_LOCAL_MACHINE\SOFTWARE\NVIDIA Corporation\Global\FTS]
"EnableRID6"=dword:00000000
"EnableRID9"=dword:00000000
"EnableRID275"=dword:00000000

; --- Отключить NVVIO/Media Streaming службы-помощники
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NvContainerLocalSystem]
"Start"=dword:00000004
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NvTelemetry]
"Start"=dword:00000004
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NvidiaDisplayDriverService]
"Start"=dword:00000003
