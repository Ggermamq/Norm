Windows Registry Editor Version 5.00

; ============================================================
; 05_RAM_16GB: профиль памяти для 16 ГБ ОЗУ (Win11 x64)
; Логика: при 16 ГБ нельзя агрессивно держать всё в RAM —
; включаем Managed Paging File, но фиксируем размер файла
; подстранично, чтобы CS2 + Windows не свопились в пике.
; Откат: _RESTORE\Restore_RAM.reg
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management]
; Файл подкаста фиксированный: InitialSize=EndSize (в МБ).
; Значения ниже = 8192 МБ фиксированный файл. Меняйте под объём:
; правило для 16 GB: 8192-12288 MB.
"PagingFiles"=hex(7): 3a,00,5c,00,70,00,61,00,67,00,66,00,69,00,6c,00,65,00,2e,00,73,00,79,00,73,00,20,00,38,00,31,00,39,00,32,00,20,00,38,00,31,00,39,00,32,00,00,00,00,00

; --- Не выгружать исполняемый код ядра/драйверов (из старого набора, исправлено)
"DisablePagingExecutive"=dword:00000001

; --- Кэш системы НЕ серверный (важно на 16 ГБ!)
"LargeSystemCache"=dword:00000000

; --- ClearPageFileAtShutdown OFF (лишняя нагрузка, приватность — см. README)
"ClearPageFileAtShutdown"=dword:00000000

; --- Пулы: дефолт Windows (старый набор ставил PagedPoolSize=0xC0 и
;     IoPageLockLimit=8MB — значения устарели и не имеют эффекта на Win11;
;     возвращаем к разумным)
"IoPageLockLimit"=dword:00000000
