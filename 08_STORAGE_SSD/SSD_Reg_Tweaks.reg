Windows Registry Editor Version 5.00

; ============================================================
; 08_STORAGE_SSD: NVMe/SATA SSD твики (из старого набора, исправлено)
; - MaxIORequests stornvme: 100 (dword:64) — было в старом наборе, ок
; - QueueDepth storahci: 50 (dword:32) — было, ок
; - StorageD3InModernStandby OFF — было, ок (предотвращает "просыпание"
;   диска посреди матча = редкие, но злые фризы)
; - Гибернация OFF (старый файл ставил HibernateEnabled=0 — оставляем,
;   экономит RAM-объём hiberfil и убирает один источник D3-переходов)
; Откат: _RESTORE\Restore_Storage.reg
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\stornvme\Parameters\Device]
"MaxIORequests"=dword:00000064

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\storahci\Parameters\Device]
"QueueDepth"=dword:00000032

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Storage]
"StorageD3InModernStandby"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Power]
"HibernateEnabled"=dword:00000000

; --- Отключить TRIM-планировщик дефрага на SSD (defrag не трогает SSD,
;     но оптимизация раз в неделю без проблем — оставляем включённой).
; --- Disable last access time update на томах — меньше записей metadata
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem]
"NtfsDisableLastAccessUpdate"=dword:00000001
"Win95TruncatedExtensions"=dword:00000001
"LongPathsEnabled"=dword:00000001
