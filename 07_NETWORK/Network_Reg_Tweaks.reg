Windows Registry Editor Version 5.00

; ============================================================
; 07_NETWORK: реестровая часть сетевых твиков (LAN/SMB из старого
; "Decrease Ping.bat"/"Decrease Delay.reg", значения проверены).
; Откат: _RESTORE\Restore_Network.reg
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\AFD\Parameters]
; Увеличить буферы сокета — меньше потерь/джиттера на загрузке
"DefaultReceiveWindow"=dword:00100000
"DefaultSendWindow"=dword:00100000
"IrpStackSize"=dword:00000020
"EnableFastCopyReceive"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters]
; Из старого Decrease Delay.reg — корректные значения для игрового ПК
; (SMB-сервер не нужен, но эти параметры снижают влияние шары на latency)
"Size"=dword:00000003
"EnableOplocks"=dword:00000000
"IRPStackSize"=dword:00000020
"SharingViolationDelay"=dword:00000000
"SharingViolationRetries"=dword:00000000
"autodisconnect"=dword:ffffffff

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
; Таймауты удержания неактивных соединений (быстрее освобождение сокетов)
"KeepAliveTime"=dword:000493e0
"KeepAliveInterval"=dword:000001f4
"MaxFreeTcbs"=dword:00002710
"TCPNoDelay"=dword:00000001
"TcpAckFrequency"=dword:00000001
"SackOpt"=dword:00000001
"FastOpen"=dword:00000003

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Dnscache\Parameters]
"CacheHashTableBucketSize"=dword:00000001
"CacheHashTableSize"=dword:00000180
"MaxCacheEntryTtlLimit"=dword:0000fa00
"MaxSOACacheEntryTtlLimit"=dword:0000012d
